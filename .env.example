# Home Media Stack — Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit .env to git (it contains secrets)

# ============================================
# PLEX
# ============================================
# Get token from https://plex.tv/claim (valid 4 minutes)
PLEX_TOKEN=your_plex_claim_token_here
PLEX_UID=1000
PLEX_GID=1000

# Your VM/host IP for Remote Access advertising
PLEX_ADVERTISE_IP=192.168.1.100:32400

# ============================================
# JELLYFIN
# ============================================
# Admin password for first login (change after setup)
JELLYFIN_ADMIN_PASSWORD=changeme_jellyfin_admin

# Strong random key for Jellyfin (generate with: openssl rand -hex 32)
JELLYFIN_SECRET_KEY=your_random_secret_key_here

# ============================================
# STORAGE
# ============================================
# Local secondary disk mount point (SSD, /dev/sdb formaté ext4)
# Structure:
#   /home/media-stack/
#   ├── docker-data/    (Plex, Jellyfin, Radarr, Sonarr, Lidarr configs)
#   ├── films/
#   ├── series/
#   └── music/
# Downloads (temporaires) sur volume Docker séparé, même disque local
MEDIA_STORAGE_PATH=/home/media-stack

# ============================================
# RADARR (Films)
# ============================================
RADARR_UID=1000
RADARR_GID=1000

# Radarr API key (generated after container start, fill in after setup)
RADARR_API_KEY=your_radarr_api_key_here

# ============================================
# SONARR (Séries)
# ============================================
SONARR_UID=1000
SONARR_GID=1000

# Sonarr API key (generated after container start, fill in after setup)
SONARR_API_KEY=your_sonarr_api_key_here

# ============================================
# LIDARR (Musique)
# ============================================
LIDARR_UID=1000
LIDARR_GID=1000

# Lidarr API key (generated after container start, fill in after setup)
LIDARR_API_KEY=your_lidarr_api_key_here

# ============================================
# INDEXERS (Auto-download sources)
# ============================================
# MVP: torrent-only (pas d'abonnement usenet actuellement)
# Usenet peut être ajouté plus tard sans changer l'architecture
INDEXER_TYPE=torrent

# Torrent indexer (public ou privé, à choisir lors du setup Radarr/Sonarr/Lidarr)
TORRENT_INDEXER_URL=https://rarbg.to
TORRENT_API_KEY=optional_torrent_api_key

# Usenet (optionnel, pour plus tard — laisser vide si pas utilisé)
USENET_INDEXER_URL=
USENET_API_KEY=

# qBittorrent WebUI (default login: admin / voir logs container au premier démarrage)
QBITTORRENT_WEBUI_PORT=8081

# ============================================
# ARCANE (Docker Management UI)
# ============================================
# Strong random secret for Arcane (generate with: openssl rand -hex 32)
ARCANE_SECRET=your_random_arcane_secret_here
ARCANE_PORT=8080

# ============================================
# TIMEZONE
# ============================================
TZ=Europe/Zurich

# ============================================
# DOCKER / COMPOSE
# ============================================
# Docker logging config
COMPOSE_LOG_DRIVER=json-file
COMPOSE_LOG_MAX_SIZE=10m
COMPOSE_LOG_MAX_FILE=3
